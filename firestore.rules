rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Mantras collection is read-only for all users
    match /mantras/{mantraId} {
      allow read: if true;
      allow write: if false; // Only admins can add mantras through Firebase console
    }
    
    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Users can only access their own mantra progress
      match /mantras/{mantraId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
